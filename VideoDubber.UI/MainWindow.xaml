<Window x:Class="VideoDubber.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        mc:Ignorable="d"
        Title="Video Dubber Studio (Native C# .NET 8 + SkiaSharp)" Height="720" Width="1180"
        WindowStartupLocation="CenterScreen" Background="#0F172A">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Video Player Column & Live SkiaSharp Preview -->
        <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Padding="12" Margin="0,0,16,0" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Video + Live Skia Overlay Container -->
                <Border Grid.Row="0" Background="#000000" CornerRadius="8" ClipToBounds="True">
                    <Grid x:Name="PlayerContainer">
                        <MediaElement x:Name="MediaElementPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" ScrubbingEnabled="True"/>
                        <!-- SkiaSharp GPU Overlay Canvas (100% Bit-for-bit Preview Match) -->
                        <skia:SKElement x:Name="SkiaPreviewCanvas" PaintSurface="SkiaPreviewCanvas_PaintSurface"/>
                    </Grid>
                </Border>

                <!-- Custom Scrubber Controls -->
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <Slider x:Name="VideoScrubber" Minimum="0" Maximum="100" ValueChanged="VideoScrubber_ValueChanged"/>
                    <TextBlock x:Name="TxtTimeDisplay" Text="00:00 / 00:00" Foreground="#94A3B8" HorizontalAlignment="Right" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Process Button -->
                <Button x:Name="BtnFinalProcess" Grid.Row="2" Content="✨ Final Process Video" Height="44" Margin="0,12,0,0" 
                        Background="#6366F1" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand" Click="BtnFinalProcess_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Right: Subtitle & Video Customization Studio -->
        <Border Grid.Column="1" Background="#1E293B" CornerRadius="12" Padding="16" BorderBrush="#334155" BorderThickness="1">
            <TabControl Background="Transparent" BorderThickness="0">
                <!-- Tab 1: Editor Lab (Subtitles & Style Presets) -->
                <TabItem Header="🎨 Subtitle Editor Lab" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <StackPanel Margin="0,0,8,0">
                            <!-- Toggle Subtitles -->
                            <DockPanel Margin="0,0,0,16">
                                <TextBlock Text="Burn-in Subtitles (Captions)" Foreground="#F8FAFC" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkSubToggle" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="Control_ValueChanged" Unchecked="Control_ValueChanged"/>
                            </DockPanel>

                            <!-- Style Preset & Font Selection -->
                            <UniformGrid Columns="2" Margin="0,0,0,16">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Style Preset" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CboPreset" SelectionChanged="Control_ValueChanged" Height="34" Background="#0F172A" Foreground="White">
                                        <ComboBoxItem Content="Outline" IsSelected="True"/>
                                        <ComboBoxItem Content="YellowBox"/>
                                        <ComboBoxItem Content="WhiteText"/>
                                        <ComboBoxItem Content="Glow"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="Font Family" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CboFont" SelectionChanged="Control_ValueChanged" Height="34" Background="#0F172A" Foreground="White"/>
                                </StackPanel>
                            </UniformGrid>

                            <!-- Sliders -->
                            <StackPanel Margin="0,0,0,16">
                                <DockPanel>
                                    <TextBlock Text="Size" Foreground="#CBD5E1" FontSize="13"/>
                                    <TextBlock x:Name="TxtValSize" Text="4.5%" Foreground="#6366F1" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SldSize" Minimum="2" Maximum="10" Value="4.5" SmallChange="0.1" ValueChanged="Control_ValueChanged" Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,16">
                                <DockPanel>
                                    <TextBlock Text="Text Opacity" Foreground="#CBD5E1" FontSize="13"/>
                                    <TextBlock x:Name="TxtValOpacity" Text="100%" Foreground="#6366F1" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SldOpacity" Minimum="0" Maximum="100" Value="100" ValueChanged="Control_ValueChanged" Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,16">
                                <DockPanel>
                                    <TextBlock Text="Outline Width" Foreground="#CBD5E1" FontSize="13"/>
                                    <TextBlock x:Name="TxtValOutline" Text="0.3%" Foreground="#6366F1" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SldOutline" Minimum="0" Maximum="1.5" Value="0.3" SmallChange="0.05" ValueChanged="Control_ValueChanged" Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,16">
                                <DockPanel>
                                    <TextBlock Text="Position Y" Foreground="#CBD5E1" FontSize="13"/>
                                    <TextBlock x:Name="TxtValPosY" Text="62%" Foreground="#6366F1" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SldPosY" Minimum="0" Maximum="100" Value="62" ValueChanged="Control_ValueChanged" Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- Live Sample Text Box -->
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="Live Preview Subtitle Text" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtLivePreviewText" Text="ឥឡូវនេះតើអ្នក&#x0a;អាចឱ្យខ្ញុំ&#x0a;សម្ភារៈកូនរបស់ខ្ញុំ?" Height="70" AcceptsReturn="True" TextWrapping="Wrap" 
                                         Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="8" TextChanged="Control_ValueChanged"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 2: Transcript Lab -->
                <TabItem Header="💬 Transcript Lab" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button x:Name="BtnImportSrt" Content="📥 Import SRT" Click="BtnImportSrt_Click" Margin="0,0,8,0" Padding="12,6" Background="#334155" Foreground="White" BorderThickness="0"/>
                            <Button x:Name="BtnExportSrt" Content="📤 Export SRT" Click="BtnExportSrt_Click" Padding="12,6" Background="#334155" Foreground="White" BorderThickness="0"/>
                        </StackPanel>

                        <ListBox x:Name="LstSegments" Grid.Row="1" Background="#0F172A" BorderBrush="#334155" Foreground="White"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>
